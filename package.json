{
  "name": "template-electron-react",
  "version": "0.16.0",
  "description": "A template project for developing electron application, using react and typescript.",
  "main": "build/main/index.js",
  "homepage": "https://github.com/yifanwww/template-electron-react#readme",
  "author": "yifanwww <yifanw1101@gmail.com> (https://github.com/yifanwww)",
  "bugs": {
    "url": "https://github.com/yifanwww/template-electron-react/issues"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yifanwww/template-electron-react.git"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "scripts": {
    "build": "electron-vite build --config electron.vite.config.mts",
    "clean": "pnpm run clean:build && pnpm run clean:dev",
    "clean:build": "rimraf build release",
    "clean:dev": "rimraf coverage node_modules/.cache node_modules/.vite",
    "dev": "electron-vite dev --config electron.vite.config.mts --watch",
    "dist:mac": "electron-builder build --config electron-builder.yaml --publish never --mac",
    "dist:win": "electron-builder build --config electron-builder.yaml --publish never --win",
    "format": "prettier --write \"**/*.{cjs,cts,css,html,js,json,jsx,md,mjs,mts,scss,ts,tsx,yaml,yml}\"",
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"**/*.{css,scss}\"",
    "lint-fix": "pnpm run lint:eslint --fix && pnpm run lint:stylelint --fix",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "prepare": "husky",
    "preview": "electron-vite preview --config electron.vite.config.mts --skipBuild",
    "run-bundled": "node ./scripts/run-bundled.mjs",
    "test": "pnpm run test:jsdom && pnpm run test:node",
    "test:jsdom": "vitest run --config vitest.jsdom.config.mts",
    "test:node": "vitest run --config vitest.node.config.mts",
    "typecheck": "pnpm run typecheck:src && pnpm run typecheck:config",
    "typecheck:config": "tsc --project tsconfig.config.json --noEmit --incremental false --composite false",
    "typecheck:src": "tsc --project tsconfig.json --noEmit --incremental false"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "dayjs": "^1.11.21",
    "electron-devtools-installer": "^4.0.0",
    "electron-store": "^11.0.2",
    "es-toolkit": "^1.50.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yargs-parser": "^22.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/confusing-browser-globals": "^1.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yargs-parser": "^21.0.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.26",
    "confusing-browser-globals": "^1.0.11",
    "electron": "42.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.25",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "rimraf": "^6.1.3",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "web-vitals": "^6.0.1"
  }
}
