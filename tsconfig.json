{
  "extends": "./configs/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "paths": {
      "@main/*": ["./src/main/*"],
      "@preload/*": ["./src/preload/*"],
      "@renderer/*": ["./src/renderer/*"],
      "@shared/*": ["./src/shared/*"]
    },
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": [],
  "references": [{ "path": "./tsconfig.config.json" }]
}
